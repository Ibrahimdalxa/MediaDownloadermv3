{
  "name": "Media Downloader Unleashed!!",
  "manifest_version": 3,
  "version": "4.1.11",
  "description": "__MSG_extensionDescription__",
  "author": "helloyanis",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "webRequest",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "homepage_url": "https://github.com/helloyanis/media-downloader-unleashed",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "default_locale": "en",
  "options_page": "popup.html?options=true"
}
